{
  "hosting": [
    {
      "target": "boardgameace",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/.git/**",
        "**/.github/**",
        "**/.firebase/**",
        "**/node_modules/**",
        "README.md",
        "database.rules.json",
        "*.ps1",
        "**/*.bat",
        "back-button.snippet.html",
        "legacy/**"
      ],
      "headers": [
        {
          "source": "/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "target": "sequenceace",
      "public": "legacy",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/.git/**",
        "**/.github/**",
        "**/.firebase/**",
        "**/node_modules/**",
        "**/*.bat"
      ],
      "redirects": [
        {
          "source": "/**",
          "destination": "https://boardgameace.web.app/",
          "type": 301
        }
      ]
    }
  ],
  "database": {
    "rules": "database.rules.json"
  }
}
